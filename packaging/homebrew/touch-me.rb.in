# Pre-publication draft. Copy to the approved Tap's Casks/touch-me.rb only after
# the versioned release asset and this exact checksum are publicly verified.
cask "touch-me" do
  version "0.8.0-beta.7"
  sha256 "74bf81ff7e7d1a0a1966146022b7e60841451897fee25a2dbe1449b31113da90"

  url "https://github.com/soom-kang/touch-me/releases/download/v#{version}/touch-me-#{version}-arm64.dmg"
  name "Touch Me"
  desc "Map ZEUSLAP P16KT touchscreen input to a display"
  homepage "https://github.com/soom-kang/touch-me"

  livecheck do
    skip "Beta releases are maintained manually"
  end

  depends_on arch: :arm64
  depends_on macos: :tahoe

  app "Touch Me.app"

  caveats do
    unsigned_accessibility
    <<~EOS
      This beta is ad hoc signed and is not notarized.
      Verify the release source and checksum before first launch.
      For Apple's manual approval guidance, see:
        https://support.apple.com/en-us/102445
      Allow Input Monitoring and Accessibility in System Settings.
      Before upgrading or removing the app, select Stop mapping, then normal Quit.
      If restoration or record handling fails, stop the operation and use Retry restore.
      Keep recovery records; do not delete them to complete an upgrade.
      After both recorded HID/USB services are proven ended and ownership is verified,
      the old record can be archived without confirming restoration or writing its mode to a new connection.
      During the same app run, mapping can resume on a fresh (0,0) connection
      at the saved USB location and display after safety checks.
      A connection already in (2,0) requires informed manual Start and keeps that mode on Stop.
    EOS
  end
end
